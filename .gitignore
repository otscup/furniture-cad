# ── 依赖与构建产物 ──
node_modules/
dist/
.venv/
venv/
__pycache__/
*.pyc

# ── 本地配置：里面有明文 API Key，绝不入库 ──
.env
*.env.local

# ── 运行时数据 ──
# 账号库含口令哈希（离线爆破的原料），审计日志含 IP 与操作史。
# 这两份都是每台机器各自生成的运行时数据，不是项目资产。
app/memory/accounts.json
app/memory/accounts.json.tmp
app/memory/audit.jsonl
memory/*.bak

# Chrome 临时 profile（验收时建在系统临时目录，偶尔因删除保护残留在这里）
app/verify/out/chrome-profile-*/

# 视觉 ground truth 图集：图是**可再生**的（node verify/vision-fixtures.mjs），
# 不入库；只留 truth.json（ground truth 本身要进版本库，评测卡读它）。
app/verify/fixtures/*.png
app/verify/fixtures/*.svg
app/verify/fixtures/*.html

# 验收运行日志：每次跑都变，且体积不小，不进版本控制
app/verify/out/*.log

# ── WorkBuddy ──
# 只把「决策记忆」入库（它是项目决策与踩坑的记录）；
# 其余是工具自己的运行时数据，不进版本控制。
.workbuddy/*
!.workbuddy/memory/

# demo export artifacts (regenerable)
demo-out/

# Per-account workspaces (multi-tenant runtime data) - regenerated, not version controlled
app/memory/workspaces/

# Operation sequence library (replay cache) - runtime data
app/memory/sequences.jsonl
app/memory/sequences.jsonl.tmp
# Workspace migration backups (runtime artifacts)
app/memory/*.migrated
# Acceptance run artifacts (regenerated by every verify run)
app/verify-output/
